{
  "name": "@bgb/recipe-reader",
  "version": "0.1.0",
  "description": "Turns pasted recipe text into the dough-core Recipe shape. The model reads; the engine does every number.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {

  },
  "license": "UNLICENSED",
  "dependencies": {
    "@bgb/dough-core": "file:../../packages/core"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^3.2.4"
  }
}
